// Layout de Zellij con barra de pestañas vertical a la izquierda
layout {
    pane split_direction="vertical" {
        pane size=20 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zellij-vertical-tabs.wasm" {
                format "#[fg=#52677d]{index} #[fg=#d7e9ff]{name}"
                format_active "#[fg=#03070d,bg=#22d3ee,bold,fill] ▶ {index} {name} #[fg=#071a2b]{indicators} "
                indicator_active "●"
                indicator_fullscreen " "
                indicator_sync " "
                max_name_length 13
                border "#[fg=#0e2a47]│"
                start_index 1
                padding_top 0
                overflow_above "  ▲ +{count}"
                overflow_below "  ▼ +{count}"
            }
        }
        pane
    }
    pane size=1 borderless=true {
        plugin location="zellij:status-bar"
    }
}
